{
  "manifest_version": 3,
  "name": "YouTube Fullscreen Zoom Controller",
  "description": "Adjust the zoom ratio of YouTube videos while in fullscreen mode.",
  "version": "1.0.0",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "action": {
    "default_title": "YouTube Fullscreen Zoom",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "pageHook.js"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ]
    }
  ]
}
